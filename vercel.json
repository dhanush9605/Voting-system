{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/index.cjs": {
            "runtime": "nodejs20.x"
        }
    },
    "rewrites": [
        {
            "source": "/api{/}?",
            "destination": "/api/index.cjs"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.cjs"
        },
        {
            "source": "/((?!api).*)",
            "destination": "/index.html"
        }
    ]
}